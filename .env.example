# Hearth env vars
#
# Application secrets live in `.env.local`, populated by `vercel env pull`
# from the linked Vercel project. This file documents non-obvious
# variables a new developer needs to know about.

# Model for the "Research this model" feature on inventory detail pages.
# Routes through the Vercel AI Gateway. Defaults to whatever
# BRIEFING_PRIMARY_MODEL is set to (Perplexity Sonar) since the task is
# structurally identical: live web lookup with grounding.
INVENTORY_INSIGHTS_MODEL=perplexity/sonar-pro

# Reasoning model for the maintenance-synthesis workflow (issue #126).
# Takes an item's AI insights + habitat findings + linked receipts +
# install date and emits a structured list of recurring maintenance
# tasks. Required — missing → the Build maintenance plan action
# returns the configuration error inline. Defaulted to Grok 4.3 reasoning;
# tunable per environment without code changes.
MAINTENANCE_SYNTHESIS_MODEL=xai/grok-4.3

# Storage reconciliation sweep (issue #266) — the scheduled job at
# /api/cron/storage-sweep that removes orphaned bucket objects.
#
# CRON_SECRET — shared secret the cron handler requires as
#   `Authorization: Bearer ${CRON_SECRET}`. Vercel Cron sends this header
#   automatically when the var is set on the project. Without it the route
#   returns 500 (refuses to run); a wrong/absent header returns 401.
CRON_SECRET=

# STORAGE_SWEEP_DELETE_ENABLED — master safety switch. Default (unset or
#   anything other than "true") = dry-run: the sweep logs the remove plan
#   but deletes nothing. Flip to "true" only after reviewing a dry-run's
#   logged plan against real data and confirming it flags only true orphans.
STORAGE_SWEEP_DELETE_ENABLED=false

# STORAGE_SWEEP_GRACE_HOURS — objects younger than this are never removed
#   (protects the upload-then-insert window). Optional; defaults to 24.
# STORAGE_SWEEP_GRACE_HOURS=24

# STORAGE_SWEEP_MAX_DELETIONS — if a single run would remove more than this
#   many objects, it logs-and-bails instead (regression backstop).
#   Optional; defaults to 100.
# STORAGE_SWEEP_MAX_DELETIONS=100

# Water advisory watcher (issue #331) — /api/cron/water-advisories, every
# 30 minutes. Polls each watched city's advisory page and emails the
# confirmed subscriber list on district-wide events. Shares CRON_SECRET
# with the storage sweep.
#
# RESEND_API_KEY / WATER_ADVISORY_FROM_EMAIL — Resend credentials and the
#   verified sender ("Hearth <advisories@toddtech.llc>"). Both required for
#   any email (confirmations, advisories, the admin "send test" button, and
#   the watcher alarm). Without them the watcher still records advisories;
#   it just can't send.
RESEND_API_KEY=
WATER_ADVISORY_FROM_EMAIL=

# WATER_ADVISORY_ALERT_EMAIL — where the "watcher is blind" alarm goes when
#   a source fails WATER_ADVISORY_FAILURE_ALERT_AFTER runs in a row
#   (default 6 ≈ three hours at the 30-minute cadence). At most one alarm
#   per source per WATER_ADVISORY_ALARM_COOLDOWN_HOURS (default 24), even
#   if the source recovers and fails again in between. Recovery notes are
#   off unless WATER_ADVISORY_RECOVERY_EMAILS=true — the admin page's
#   health line is the recovery signal.
WATER_ADVISORY_ALERT_EMAIL=
# WATER_ADVISORY_FAILURE_ALERT_AFTER=6
# WATER_ADVISORY_ALARM_COOLDOWN_HOURS=24
# WATER_ADVISORY_RECOVERY_EMAILS=false

# WATER_ADVISORY_FETCH_PROXY_URL — optional fetch-proxy template. The
#   Kalamazoo city site sits behind Akamai, which returns 403 to every
#   cloud egress we tested (Vercel, GitHub Actions, Cloudflare Workers)
#   while a home connection gets the page. Set this to a proxy/scraping
#   service URL with a {url} placeholder, e.g.
#   https://api.example.com/?api_key=KEY&url={url}
#   Only sources whose config sets "use_fetch_proxy": true go through it;
#   open feeds keep fetching directly. Unset = direct fetch everywhere.
# WATER_ADVISORY_FETCH_PROXY_URL=

# WATER_ADVISORY_NOTIFY_ENABLED — master switch for subscriber sends.
#   Default (unset or anything other than "true") = dry-run: the watcher
#   records advisories and logs every planned send but emails nobody.
#   Flip to "true" after a logged dry-run and a successful "Send test
#   email" from the admin page. The alarm email is independent of this.
WATER_ADVISORY_NOTIFY_ENABLED=false
