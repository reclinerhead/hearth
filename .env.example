# Hearth env vars
#
# Application secrets live in `.env.local`, populated by `vercel env pull`
# from the linked Vercel project. This file documents non-obvious
# variables a new developer needs to know about.

# Model for the "Research this model" feature on inventory detail pages.
# Routes through the Vercel AI Gateway. Defaults to whatever
# BRIEFING_PRIMARY_MODEL is set to (Perplexity Sonar) since the task is
# structurally identical: live web lookup with grounding.
INVENTORY_INSIGHTS_MODEL=perplexity/sonar-pro

# Reasoning model for the maintenance-synthesis workflow (issue #126).
# Takes an item's AI insights + habitat findings + linked receipts +
# install date and emits a structured list of recurring maintenance
# tasks. Required — missing → the Build maintenance plan action
# returns the configuration error inline. Defaulted to Grok 4.3 reasoning;
# tunable per environment without code changes.
MAINTENANCE_SYNTHESIS_MODEL=xai/grok-4.3

# Storage reconciliation sweep (issue #266) — the scheduled job at
# /api/cron/storage-sweep that removes orphaned bucket objects.
#
# CRON_SECRET — shared secret the cron handler requires as
#   `Authorization: Bearer ${CRON_SECRET}`. Vercel Cron sends this header
#   automatically when the var is set on the project. Without it the route
#   returns 500 (refuses to run); a wrong/absent header returns 401.
CRON_SECRET=

# STORAGE_SWEEP_DELETE_ENABLED — master safety switch. Default (unset or
#   anything other than "true") = dry-run: the sweep logs the remove plan
#   but deletes nothing. Flip to "true" only after reviewing a dry-run's
#   logged plan against real data and confirming it flags only true orphans.
STORAGE_SWEEP_DELETE_ENABLED=false

# STORAGE_SWEEP_GRACE_HOURS — objects younger than this are never removed
#   (protects the upload-then-insert window). Optional; defaults to 24.
# STORAGE_SWEEP_GRACE_HOURS=24

# STORAGE_SWEEP_MAX_DELETIONS — if a single run would remove more than this
#   many objects, it logs-and-bails instead (regression backstop).
#   Optional; defaults to 100.
# STORAGE_SWEEP_MAX_DELETIONS=100
